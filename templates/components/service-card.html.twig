{# Карточка услуги эксперта #}
{#
    @var title       string  Название услуги
    @var expert      string  Имя эксперта
    @var expertRole  string  Роль/направление эксперта
    @var description string  Описание
    @var price       string  Цена
    @var priceNote   string  Пояснение к цене («от», «по договорённости»)
    @var orderUrl    string  Ссылка «Оформить»
#}
<article class="flex h-full flex-col rounded-2xl border border-border bg-surface p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
    <div class="flex items-center gap-3">
        <span class="grid size-12 shrink-0 place-items-center rounded-full bg-gradient-to-br from-brand to-brand-dark text-base font-bold text-surface" aria-hidden="true">
            {{ expert|slice(0, 1) }}
        </span>
        <div class="min-w-0">
            <p class="truncate font-semibold">{{ expert }}</p>
            <p class="flex items-center gap-1 text-xs text-muted">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5"/>
                </svg>
                {{ expertRole }}
            </p>
        </div>
    </div>

    <h3 class="mt-4 text-lg font-semibold leading-snug text-pretty">{{ title }}</h3>
    <p class="mt-2 text-sm leading-relaxed text-muted line-clamp-3">{{ description }}</p>

    <div class="mt-auto pt-4">
        <p class="text-xl font-bold text-brand">
            <span class="sr-only">Цена: </span>{{ price }}
        </p>
        {% if priceNote %}
            <p class="text-xs text-muted">{{ priceNote }}</p>
        {% endif %}
        <a href="{{ orderUrl }}"
           class="mt-3 inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-brand px-5 py-2.5 font-semibold text-surface transition hover:bg-brand-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand active:bg-brand-dark">
            Оформить
        </a>
    </div>
</article>
