{# Карточка новости #}
{#
    @var title   string  Заголовок
    @var excerpt string  Краткий текст
    @var badge   string  Рубрика
    @var date    string  Дата публикации
    @var url     string  Ссылка
    @var tone    string  Токен-градиент картинки-плейсхолдера
#}
<article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface transition hover:-translate-y-0.5 hover:shadow-lg">
    <a href="{{ url }}" class="flex h-full flex-col focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
        <div class="relative isolate aspect-video overflow-hidden bg-gradient-to-br {{ tone }}" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="absolute -right-6 -bottom-8 size-32 text-surface/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>
            </svg>
        </div>
        <div class="flex flex-1 flex-col gap-2 p-4 md:p-5">
            <div class="flex items-center gap-2 text-xs">
                <span class="rounded-full bg-brand-light px-2.5 py-1 font-semibold text-brand-dark">{{ badge }}</span>
                <span class="text-muted">{{ date }}</span>
            </div>
            <h3 class="text-lg font-semibold leading-snug text-pretty transition group-hover:text-brand">{{ title }}</h3>
            <p class="text-sm leading-relaxed text-muted line-clamp-3">{{ excerpt }}</p>
        </div>
    </a>
</article>
