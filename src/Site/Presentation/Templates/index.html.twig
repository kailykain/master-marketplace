{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} — услуги проверенных экспертов{% endblock %}

{% block body %}
    {# ─── Hero-слайдер ─── #}
    <section aria-label="О платформе" data-controller="slider" data-slider-interval-value="7000">
        <div class="relative">
            <div data-slider-target="track"
                 class="flex snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                {% for slide in slides %}
                    <article data-slider-target="slide" class="w-full shrink-0 snap-center" aria-roledescription="слайд" aria-label="{{ loop.index }} из {{ slides|length }}">
                        {% set heading_tag = loop.first ? 'h1' : 'h2' %}
                        <div class="relative isolate overflow-hidden bg-gradient-to-br {{ slide.theme }} text-surface">
                            {# Декоративные фигуры #}
                            <svg class="pointer-events-none absolute -top-16 -right-16 size-72 rounded-full bg-surface/10" aria-hidden="true"></svg>
                            <svg class="pointer-events-none absolute -bottom-24 right-32 size-48 rounded-full bg-surface/10" aria-hidden="true"></svg>

                            <div class="mx-auto grid max-w-page items-center gap-8 px-4 py-14 md:grid-cols-2 md:px-6 md:py-20 lg:py-24">
                                <div class="max-w-xl">
                                    <{{ heading_tag }} class="text-3xl font-bold text-balance md:text-4xl lg:text-5xl lg:text-pretty">
                                        {{ slide.title }}
                                    </{{ heading_tag }}>
                                    <p class="mt-4 text-base leading-relaxed text-surface/85 md:text-lg">{{ slide.text }}</p>
                                    <a href="{{ slide.url }}"
                                       class="mt-6 inline-flex min-h-11 items-center justify-center rounded-xl bg-surface px-6 py-2.5 font-semibold text-brand-dark transition hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface active:bg-surface-alt">
                                        {{ slide.cta }}
                                    </a>
                                </div>

                                {# Декоративная картинка-плейсхолдер #}
                                <div class="hidden md:block" aria-hidden="true">
                                    <div class="mx-auto aspect-[4/3] w-full max-w-md rounded-3xl bg-surface/15 p-8 backdrop-blur-sm">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="size-full text-surface/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>

            {# Стрелки (десктоп) #}
            <button type="button" data-action="slider#prev" aria-label="Предыдущий слайд"
                    class="absolute top-1/2 left-3 hidden size-11 -translate-y-1/2 place-items-center rounded-full bg-surface/25 text-surface backdrop-blur transition hover:bg-surface/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface md:grid">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button type="button" data-action="slider#next" aria-label="Следующий слайд"
                    class="absolute top-1/2 right-3 hidden size-11 -translate-y-1/2 place-items-center rounded-full bg-surface/25 text-surface backdrop-blur transition hover:bg-surface/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface md:grid">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>

            {# Точки #}
            <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 items-center gap-2">
                {% for slide in slides %}
                    <button type="button"
                            data-slider-target="dot"
                            data-action="slider#go"
                            data-slider-index-param="{{ loop.index0 }}"
                            aria-label="Слайд {{ loop.index }}"
                            class="grid size-11 place-items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface">
                        <span class="h-2 w-2 rounded-full bg-surface/50 transition-all duration-300"></span>
                    </button>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ─── Почему платформа (шахматный порядок) ─── #}
    <section class="bg-surface-alt" aria-labelledby="features-title">
        <div class="mx-auto max-w-page px-4 py-12 md:px-6 md:py-16 lg:py-20">
            <h2 id="features-title" class="text-2xl font-bold text-pretty md:text-3xl">Почему ЭкспертПро</h2>

            <div class="mt-8 flex flex-col gap-12 md:mt-10 md:gap-16">
                {% for feature in features %}
                    <div class="grid items-center gap-6 md:grid-cols-2 md:gap-10 lg:gap-16">
                        <div class="relative isolate aspect-[4/3] overflow-hidden rounded-3xl bg-gradient-to-br {{ feature.tone }}" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 m-auto size-24 text-surface/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                                <path d="{{ feature.icon }}"/>
                            </svg>
                        </div>
                        <div class="{{ loop.index is even ? 'md:order-first' : '' }}">
                            <h3 class="text-xl font-semibold text-balance md:text-2xl">{{ feature.title }}</h3>
                            <p class="mt-3 leading-relaxed text-muted">{{ feature.text }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ─── Услуги ─── #}
    <section aria-labelledby="services-title">
        <div class="mx-auto max-w-page px-4 py-12 md:px-6 md:py-16 lg:py-20">
            <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                    <h2 id="services-title" class="text-2xl font-bold text-pretty md:text-3xl">Популярные услуги</h2>
                    <p class="mt-2 text-muted">Проверенные эксперты и прозрачные условия заказа</p>
                </div>
                <a href="#" class="inline-flex min-h-11 items-center rounded-xl px-4 py-2 font-semibold text-brand transition hover:bg-brand-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
                    Все услуги
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </a>
            </div>

            {% if services is not empty %}
                <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 md:mt-10 md:gap-6 xl:grid-cols-4">
                    {% for service in services %}
                        <li class="h-full">
                            {% include 'components/service-card.html.twig' with {
                                title: service.title,
                                expert: service.expert,
                                expertRole: service.expertRole,
                                description: service.description,
                                price: service.price,
                                priceNote: service.priceNote,
                                orderUrl: '#',
                            } only %}
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <div class="mt-8 rounded-2xl border border-dashed border-border bg-surface-alt p-8 text-center md:mt-10">
                    <p class="font-semibold">Услуги скоро появятся</p>
                    <p class="mt-1 text-sm text-muted">Загляните позже или подберите эксперта через заявку.</p>
                </div>
            {% endif %}
        </div>
    </section>

    {# ─── Как это работает ─── #}
    <section class="bg-surface-alt" aria-labelledby="how-title">
        <div class="mx-auto max-w-page px-4 py-12 md:px-6 md:py-16 lg:py-20">
            <h2 id="how-title" class="text-2xl font-bold text-pretty md:text-3xl">Как это работает</h2>

            <ol class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 md:mt-10 lg:grid-cols-4">
                {% for step in steps %}
                    <li class="relative rounded-2xl border border-border bg-surface p-5">
                        <span class="grid size-10 place-items-center rounded-xl bg-brand-light text-lg font-bold text-brand-dark" aria-hidden="true">{{ loop.index }}</span>
                        <h3 class="mt-4 font-semibold">{{ step.title }}</h3>
                        <p class="mt-1 text-sm leading-relaxed text-muted">{{ step.text }}</p>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </section>

    {# ─── Новости ─── #}
    <section aria-labelledby="news-title">
        <div class="mx-auto max-w-page px-4 py-12 md:px-6 md:py-16 lg:py-20">
            <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                    <h2 id="news-title" class="text-2xl font-bold text-pretty md:text-3xl">Новости платформы</h2>
                    <p class="mt-2 text-muted">События академии и наших экспертов</p>
                </div>
                <a href="#" class="inline-flex min-h-11 items-center rounded-xl px-4 py-2 font-semibold text-brand transition hover:bg-brand-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
                    Все новости
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </a>
            </div>

            {% if news is not empty %}
                <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 md:mt-10 md:gap-6 lg:grid-cols-3">
                    {% for item in news %}
                        <li class="h-full">
                            {% include 'components/news-card.html.twig' with {
                                title: item.title,
                                excerpt: item.excerpt,
                                badge: item.badge,
                                date: item.date,
                                url: '#',
                                tone: item.tone,
                            } only %}
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <div class="mt-8 rounded-2xl border border-dashed border-border bg-surface-alt p-8 text-center md:mt-10">
                    <p class="font-semibold">Новостей пока нет</p>
                    <p class="mt-1 text-sm text-muted">Мы уже готовим первые публикации.</p>
                </div>
            {% endif %}
        </div>
    </section>

    {# ─── CTA: подбор эксперта ─── #}
    <section aria-labelledby="cta-title">
        <div class="mx-auto max-w-page px-4 pb-4 md:px-6">
            <div class="relative isolate overflow-hidden rounded-3xl bg-gradient-to-br from-brand to-brand-dark px-4 py-12 text-center text-surface md:px-6 md:py-16">
                <svg class="pointer-events-none absolute -top-12 -left-12 size-48 rounded-full bg-surface/10" aria-hidden="true"></svg>
                <svg class="pointer-events-none absolute -right-16 -bottom-16 size-64 rounded-full bg-surface/10" aria-hidden="true"></svg>

                <div class="mx-auto max-w-2xl">
                    <h2 id="cta-title" class="text-2xl font-bold text-balance md:text-3xl">Не нашли нужную услугу?</h2>
                    <p class="mt-3 text-surface/85 md:text-lg">Оставьте заявку — менеджер подберёт эксперта под вашу задачу в течение рабочего дня.</p>
                    <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
                        <a href="#" class="inline-flex min-h-11 items-center justify-center rounded-xl bg-surface px-6 py-2.5 font-semibold text-brand-dark transition hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface active:bg-surface-alt">Подобрать эксперта</a>
                        <a href="#" class="inline-flex min-h-11 items-center justify-center rounded-xl border border-surface/40 px-6 py-2.5 font-semibold text-surface transition hover:bg-surface/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface active:bg-surface/10">Стать экспертом</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
